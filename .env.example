# Optional OpenAI-compatible model settings. Leave blank for the offline harness.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_REPLACE_MAX_TOKENS=384
# Local Compose deployment. Generate a distinct private password in your .env.
POSTGRES_PASSWORD=
REPOEVO_SANDBOX_URL=http://host.docker.internal:19090
REPOEVO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
# Optional shared services. Leave blank to use the local SQLite runtime fallback.
CHECKPOINT_DSN=
REDIS_URL=
REPOEVO_DATA_ROOT=.artifacts/runtime
REPOEVO_ARTIFACT_ROOT=.artifacts/files
API_HOST=127.0.0.1
API_PORT=8080
# Optional GPU/vLLM settings. Fill these only after uploading a real model.
VLLM_MODEL_PATH=
VLLM_API_KEY=
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=8192
